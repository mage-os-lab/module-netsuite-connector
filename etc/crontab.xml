<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="send_queue_warnings" instance="MageOS\NetSuiteConnector\Core\Cron\SendQueueWarnings" method="execute">
            <schedule>1 * * * *</schedule>
        </job>
        <job name="fix_stuck_messages_in_queue" instance="\MageOS\NetSuiteConnector\Core\Cron\FixStuckMessages" method="execute">
            <schedule>42 * * * *</schedule>
        </job>
        <job name="clean_monitor" instance="MageOS\NetSuiteConnector\Core\Cron\CleanMonitor" method="execute">
            <schedule>0 1 * * *</schedule>
        </job>
    </group>
</config>
