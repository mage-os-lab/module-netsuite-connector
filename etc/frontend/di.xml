<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- PLUGINS -->
     <type name="Magento\Framework\Message\ManagerInterface">
        <plugin sortOrder="1" name="netsuite_customer_import_modify_messages_if_pwd_is_not_set"
                type="MageOS\NetSuiteConnector\CustomerImport\Plugin\MessageManagerInterfacePlugin"/>
    </type>

    <!-- ARGUMENTS -->
    <type name="Magento\Framework\View\Element\Message\MessageConfigurationsPool">
        <arguments>
            <argument name="configurationsMap" xsi:type="array">
                <item name="customerLoginButPasswordNotSet" xsi:type="array">
                    <item name="renderer" xsi:type="const">\Magento\Framework\View\Element\Message\Renderer\BlockRenderer::CODE</item>
                    <item name="data" xsi:type="array">
                        <item name="template" xsi:type="string">MageOS_NetSuiteConnector::messages/customerLoginButPasswordNotSet.phtml</item>
                    </item>
                </item>
                <item name="customerRegistrationButPasswordNotSet" xsi:type="array">
                    <item name="renderer" xsi:type="const">\Magento\Framework\View\Element\Message\Renderer\BlockRenderer::CODE</item>
                    <item name="data" xsi:type="array">
                        <item name="template" xsi:type="string">MageOS_NetSuiteConnector::messages/customerRegistrationButPasswordNotSet.phtml</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
