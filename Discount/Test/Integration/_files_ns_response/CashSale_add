<?php
if (!isset($success)) {
    throw new \Exception(sprintf('file %s missing $success', __FILE__));
}

$response = new \NetSuite\Classes\AddResponse();
$response->writeResponse = new \NetSuite\Classes\WriteResponse();
$response->writeResponse->status = new \NetSuite\Classes\Status();

if ($success == 1) {
    if (!isset($netsuiteId)) {
        throw new \Exception(sprintf('file %s missing $netsuiteId', __FILE__));
    }

    $response->writeResponse->status->isSuccess = true;
    $response->writeResponse->baseRef = new \NetSuite\Classes\RecordRef();
    $response->writeResponse->baseRef->internalId = $netsuiteId;
    $response->writeResponse->baseRef->type = \NetSuite\Classes\RecordType::cashSale;
} else {
    $response->writeResponse->status->isSuccess = false;
    $response->writeResponse->status->statusDetail = [];
    $response->writeResponse->status->statusDetail[0] = new \NetSuite\Classes\StatusDetail();
    $response->writeResponse->status->statusDetail[0]->code = 'unknown_code';
    $response->writeResponse->status->statusDetail[0]->message = 'unknown_message';
}

return $response;