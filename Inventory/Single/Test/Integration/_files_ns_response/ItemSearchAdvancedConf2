$searchResponse = new \NetSuite\Classes\SearchResponse();
$searchResponse->searchResult = new \NetSuite\Classes\SearchResult();
$searchResponse->searchResult->status = new \NetSuite\Classes\Status();
$searchResponse->searchResult->status->isSuccess = $success;
$searchResponse->searchResult->searchRowList = new \NetSuite\Classes\SearchRowList();
$rows = [];
foreach (['1' => 10.0, '2' => 0.0] as $internalIdValue => $qty) {
    $row = new \NetSuite\Classes\ItemSearchRow();
    $row->basic = new \NetSuite\Classes\ItemSearchRowBasic();
    $internalId = new \NetSuite\Classes\SearchColumnSelectField();
    $internalId->searchValue = new \NetSuite\Classes\RecordRef();
    $internalId->searchValue->internalId = $internalIdValue;
    $row->basic->internalId = [$internalId];
    $row->basic->quantityOnHand = [];
    $row->basic->quantityOnHand[0] = new \NetSuite\Classes\SearchColumnDoubleField();
    $row->basic->quantityOnHand[0]->searchValue = $qty;
    $rows[] = $row;
}

$searchResponse->searchResult->searchRowList->searchRow = $rows;

return $searchResponse;